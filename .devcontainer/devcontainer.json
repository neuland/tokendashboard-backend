{
    // COMPOSE_PROJECT_NAME comes from the justfile, so this devcontainer only works when
    // started through it (`just claude`), not opened directly from an IDE.
    "name": "${localEnv:COMPOSE_PROJECT_NAME}",
    "dockerComposeFile": "docker-compose.yaml",
    "service": "dev",
    "runServices": ["dev", "postgres", "forward-stack", "forward-gradle"],
    "workspaceFolder": "/workspaces/${localEnv:COMPOSE_PROJECT_NAME}",
    "initializeCommand": "${localWorkspaceFolder}/.devcontainer/init.sh",
    "overrideCommand": true,
    "features": {
        "ghcr.io/devcontainers/features/node:2.0.0": {
            "version": "24"
        },
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "shutdownAction": "stopCompose",
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "jetbrains": {
            "backend": "IntelliJ",
            "settings" : {},
            "plugins" : []
        }
    }
}
